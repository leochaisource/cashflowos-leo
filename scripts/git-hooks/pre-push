#!/bin/sh
# Shared-checkout push guard (Leo, 2026-10-22). Installed for this checkout with
#   git config core.hooksPath scripts/git-hooks
#
# Several Claude sessions commit in this folder, and some hold commits for Leo's
# OK. A push ships EVERY commit between the remote and HEAD, not just yours: on
# 2026-10-22 one push deployed four commits another session was still holding.
#
# So every push lists what it would ship, and a push carrying more than one
# commit stops until someone acknowledges the count:
#   PUSH_OK=<n> git push                          (Git Bash)
#   $env:PUSH_OK='<n>'; git push; Remove-Item Env:PUSH_OK   (PowerShell)
# Give that only when every listed commit is yours, or Leo OK'd the others.

remote="$1"
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                 # deleting a remote branch

  if [ "$remote_sha" = "$zero" ]; then                     # a new branch: whatever no remote has yet
    range="$local_sha --not --remotes=$remote"
  elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    continue                                               # remote moved on; git will refuse the push itself
  fi

  n=$(git rev-list --count $range)
  [ "$n" -eq 0 ] && continue

  echo "pre-push: this push ships $n commit(s) to ${remote_ref#refs/heads/}:" >&2
  git log --format='  %h  %ad  %s' --date=format:'%d %b %H:%M' $range >&2

  if [ "$n" -gt 1 ] && [ "${PUSH_OK:-}" != "$n" ]; then
    echo "" >&2
    echo "Stopped: other sessions commit in this folder, so some of these may not be yours." >&2
    echo "If every one is yours or Leo OK'd them, push again with PUSH_OK=$n." >&2
    status=1
  fi
done

exit $status
